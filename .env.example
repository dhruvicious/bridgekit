# Local demo mode requires no provider accounts. Use BRIDGEKIT_MODE=live for real APIs.
BRIDGEKIT_MODE=mock
BRIDGEKIT_ENV=
BRIDGEKIT_PUBLIC_URL=https://gateway.example.com
BRIDGEKIT_API_TOKEN=
BRIDGEKIT_ENCRYPTION_KEY=
BRIDGEKIT_WEBHOOK_SECRET=
BRIDGEKIT_ALERT_WEBHOOK_URL=

# Required in live mode for Slack and GitHub OAuth app installations.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_API_URL=https://api.github.com
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_API_URL=https://slack.com/api
STRIPE_API_URL=https://api.stripe.com
